{
  "name": "@bryson-benjamin/web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bun run validate:sa-sa && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:sa-sa": "bun ../../scripts/validateSaSaAssets.mjs",
    "d1:migrate": "wrangler d1 migrations apply brysonbenjamin-public --remote",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@bryson-benjamin/sa-sa-contracts": "workspace:*",
    "@bryson-benjamin/portfolio-content": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "^4.1.10",
    "wrangler": "latest"
  }
}
